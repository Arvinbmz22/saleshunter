# Search: tavily | serper | brave | mock
SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Search engine budget (all optional — defaults shown)
SEARCH_BUDGET=80              # max queries per search
SEARCH_MAX_ROUNDS=7           # max adaptive search rounds
SEARCH_MAX_CANDIDATES=        # default: max(120, limit*15)
SEARCH_MAX_TIME_MS=120000     # wall-clock budget for discovery
SEARCH_RESULTS_PER_QUERY=10   # results kept per query
SEARCH_TIMEOUT_MS=12000       # per provider call timeout

# AI: openai | openai-compatible | mock
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional Arena-compatible OpenAI-style endpoint
# OPENAI_BASE_URL=https://your-arena-host/v1

# Optional: override leads storage dir (defaults to ./data)
# LEADS_DATA_DIR=./data

ENABLE_PAGE_FETCH=false
